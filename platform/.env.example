# Local development with no GitHub at all:
#   node web/build.mjs --live && cd platform && npm install && node src/main.mjs dev
#   then open http://localhost:8080/api/auth/dev?login=your-name
#
# In production these are set by .github/workflows/deploy.yml (environment variables + Secret Manager).
GITHUB_ORG=timirt-bet
GITHUB_LEARNERS_TEAM=learners
GITHUB_TEMPLATE_REPO=student-template
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem   # or GITHUB_APP_PRIVATE_KEY with the PEM itself
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
SESSION_SECRET=
APP_URL=https://timirtbet.web.app
GOOGLE_CLOUD_PROJECT=     # set: use Firestore. Unset in dev: in-memory store
GRADER_URL=               # production: the private grader service URL
TASKS_AUDIENCE=           # production: https://<api>.run.app/api/tasks
TASKS_INVOKER_EMAIL=      # production: tasks-invoker@<project>.iam.gserviceaccount.com
PORT=8080
