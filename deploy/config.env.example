# Copy to deploy/config.env and fill in. Used by deploy/setup.sh (once) and mirrored as
# GitHub repository variables for .github/workflows/deploy.yml.
PROJECT_ID=timirtbet
REGION=us-central1
BILLING_ACCOUNT=000000-000000-000000        # gcloud billing accounts list
PLATFORM_REPO=timirt-bet/timirtbet-platform  # the GitHub repository that holds this code (for deploys)
GITHUB_ORG=timirt-bet                       # the organization learners join
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
GITHUB_CLIENT_ID=
GITHUB_APP_PRIVATE_KEY_FILE=./github-app.pem
